# Local development values. Production is https://api.finnri.app and
# https://finnri.app — both are NEXT_PUBLIC_*, so they are inlined at BUILD
# time and must be set in the deploy platform's build environment, not at
# runtime. A production build refuses to start with a localhost site URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.finnri.app
# Publishes /contact with the merchant identity below. Leave unset (or anything
# other than "true") until the Razorpay KYC submission fixes what that identity
# is: /contact then 404s and drops out of the sitemap and footers, which is the
# honest state. Set it to true and the three values below become mandatory —
# a production build fails without them rather than shipping a blank address.
NEXT_PUBLIC_MERCHANT_IDENTITY_PUBLISHED=
# Must exactly match the business identity and contact details submitted for KYC.
# Only read when NEXT_PUBLIC_MERCHANT_IDENTITY_PUBLISHED=true.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_PHONE=
API_URL=http://localhost:8080
API_AUTH_BEARER=
# Android App Links. The app-signing SHA-256 from Play Console → Release →
# Setup → App signing, plus the upload certificate, comma separated. Until
# this is set, /.well-known/assetlinks.json answers 404 and invite links open
# the web page instead of the app — which is the safe state, because a
# statement with a wrong fingerprint makes Android distrust the domain.
ANDROID_CERT_SHA256_FINGERPRINTS=
# iOS Universal Links. Find the ten-character Team ID in Apple Developer →
# Membership details. Multiple valid signing teams may be comma separated.
APPLE_TEAM_IDS=
